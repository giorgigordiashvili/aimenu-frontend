# Copy to .env and fill in real values. Everything here is safe to ship to
# git — the .env itself is gitignored and holds secrets.

# Backend API base URL. Prod points at admin.aimenu.ge; dev often points at
# localhost or a staging DO app.
NEXT_PUBLIC_API_URL=https://admin.aimenu.ge

# Microsoft Clarity project id for session recording + heatmaps. Blank = no
# tracking script injected.
NEXT_PUBLIC_CLARITY_ID=

# Dev-only bypass of the BOG / Flitt hosted-checkout redirect. Set to "true"
# only in local development so orders submit straight to the kitchen without
# a real payment. NEVER enable in production.
NEXT_PUBLIC_BYPASS_PAYMENT=false

# Social login — Google OAuth 2.0 Client ID (Web application) from Google
# Cloud Console. Frontend only needs the client_id; client_secret lives on
# the backend side in GOOGLE_OAUTH_CLIENT_SECRET.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Social login — Facebook App ID from Meta for Developers. Same: frontend
# uses the App ID to init the JS SDK; App Secret is backend-only.
NEXT_PUBLIC_FACEBOOK_APP_ID=
